rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function owner(uid) { return signed() && request.auth.uid == uid; }
  function admin() { return signed() && request.auth.token.admin == true; }
  match /users/{uid} {
   allow read: if signed();
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['uid','displayName','avatarUrl','bio','coins','totalWon','todayWon','level','followersCount','followingCount','receivedGifts','createdAt']) && request.resource.data.uid == uid && request.resource.data.coins == 0 && request.resource.data.totalWon == 0 && request.resource.data.todayWon == 0 && request.resource.data.level == 1 && request.resource.data.followersCount == 0 && request.resource.data.followingCount == 0 && request.resource.data.receivedGifts == {};
   allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','avatarUrl','bio','updatedAt']) && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80 && request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 2048;
  }
  match /follows/{fid} {
   allow read: if signed();
   allow create: if signed() && request.resource.data.keys().hasOnly(['followerId','followingId','createdAt']) && request.resource.data.followerId == request.auth.uid && request.resource.data.followingId != request.auth.uid && fid == request.auth.uid + '_' + request.resource.data.followingId;
   allow delete: if signed() && resource.data.followerId == request.auth.uid;
  }
  function publicRoom(rid) { return exists(/databases/$(database)/documents/rooms/$(rid)) && get(/databases/$(database)/documents/rooms/$(rid)).data.isPrivate == false; }
  match /rooms/{rid} {
   allow read: if resource.data.isPrivate == false || (signed() && resource.data.hostId == request.auth.uid);
   allow create: if signed() && request.resource.data.hostId == request.auth.uid && request.resource.data.isPrivate == false;
   allow update: if (signed() && resource.data.hostId == request.auth.uid) && request.resource.data.hostId == resource.data.hostId;
   allow delete: if admin() || (signed() && resource.data.hostId == request.auth.uid);
   match /messages/{mid} {
    allow read: if signed() && publicRoom(rid);
    allow create: if signed() && publicRoom(rid) && request.resource.data.userId == request.auth.uid && request.resource.data.type == 'chat' && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
   }
   match /signals/{sid} {
    allow read: if signed() && publicRoom(rid) && resource.data.to == request.auth.uid;
    allow create: if signed() && publicRoom(rid) && request.resource.data.from == request.auth.uid && request.resource.data.to is string && request.resource.data.createdAt == request.time;
    allow delete: if signed() && resource.data.to == request.auth.uid;
   }
   match /presence/{uid} {
    allow read: if signed() && publicRoom(rid);
    allow write: if owner(uid) && publicRoom(rid);
   }
  }
  match /giftRankings/{rid} { allow read: if true; }
  match /gameRankings/{rid} { allow read: if true; }
  match /gameRounds/{rid} { allow read: if signed() && resource.data.userId == request.auth.uid; }
  match /settings/{sid} { allow read: if true; allow write: if admin(); }
  match /transactions/{id} { allow read: if admin(); }
  match /{document=**} { allow read, write: if false; }
 }
}
